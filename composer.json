{
    "name": "devniox/ai-automation",
    "description": "Reusable Laravel package for AI-powered customer automation.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Devniox",
            "email": "hello@devniox.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/config": "^11.0|^12.0",
        "illuminate/console": "^11.0|^12.0",
        "illuminate/database": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "illuminate/queue": "^11.0|^12.0",
        "illuminate/routing": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0"
    },
    "require-dev": {
        "laravel/framework": "^11.0",
        "laravel/pint": "^1.16",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^9.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Devniox\\AiAutomation\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Devniox\\AiAutomation\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Devniox\\AiAutomation\\AiAutomationServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "format": "pint",
        "check-format": "pint --test"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "audit": {
            "block-insecure": false
        }
    }
}
